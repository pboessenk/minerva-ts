{
  "name": "minerva",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "serve": "node packages/server/src/cli.ts",
    "new-model": "node packages/server/src/new-model.ts",
    "build": "node packages/web/build-dist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @minerva/e2e test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "golden:update": "node packages/server/test/update-golden.ts",
    "sivi:update": "node packages/sivi-updater/src/cli.ts",
    "check": "pnpm typecheck && pnpm test",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
