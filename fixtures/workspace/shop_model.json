  "operations": [
    {
      "id": "createOrder",
      "method": "POST",
      "path": "/orders",
      "summary": "Place an order",
      "description": "Creates an order.\nIdempotent per X-Request-Id.\n\n\nSee the guide.",
      "tags": ["orders", "checkout"],
      "requestBody": "Order",
      "parameters": [
        { "name": "X-Request-Id", "in": "header", "type": "string", "required": true, "description": "Idempotency key." },
        { "name": "dryRun", "in": "query", "type": "boolean", "required": false, "description": "" }
      ],
      "responses": {
        "201": { "description": "Created", "schema": "Result" },
        "400": { "description": "Invalid order", "schema": "Error" },
        "500": { "description": "It's broken", "schema": "" }
      }
    },
    {
      "id": "getOrder",
      "method": "GET",
      "path": "/orders/{orderId}",
      "summary": "Get an order",
      "description": "",
      "tags": ["orders"],
      "requestBody": "",
      "parameters": [{ "name": "orderId", "in": "path", "type": "string", "required": true, "description": "The order." }],
      "responses": {
        "404": { "description": "Not found", "schema": "Error" },
        "200": { "description": "The order", "schema": "Order" }
      }
    },
    {
      "id": "putAttachments",
      "method": "PUT",
      "path": "/orders/{orderId}/documents",
      "summary": "Attach documents",
      "description": "",
      "tags": ["documents"],
      "requestBody": "Document",
      "requestBodyArray": true,
      "parameters": [{ "name": "orderId", "in": "path", "type": "string", "required": true }],
      "responses": {
        "207": { "description": "One result per document", "schema": "Result", "responseBodyArray": true },
        "413": { "description": "Too large", "schema": "Error" }
      }
    },
