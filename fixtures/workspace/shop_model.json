        "customer": { "entityType": "privatePerson", "name": "Ada <Lovelace> & co", "birthDate": "1990-12-10", "_typeMap": { "name": "string" } },
        "lines": [{ "product": "SKU-1", "quantity": "2", "unitPrice": "9.99", "big": "9007199254740993" }],
        "delivery": { "street": "Main St", "houseNumber": "12", "city": "Springfield" },
        "_typeMap": { "total": "number" }
      },
      "response": { "id": "R-1", "accepted": "true", "warnings": [] },
      "responseCode": "201"
    },
